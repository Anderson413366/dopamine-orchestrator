# Current static version
# No active environment variables are required.

# App URL - optional, useful for deployment notes and future app framework migration.
PUBLIC_APP_URL=http://localhost:4173

# Supabase - Future Ready / Not Active Yet
# Add only if the app later gains accounts, saved records, private files, admin workflows,
# portals, or remote persistence.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase Admin - Future Ready / Server Only / Not Active Yet
# Never expose this value in browser code.
SUPABASE_SERVICE_ROLE_KEY=
